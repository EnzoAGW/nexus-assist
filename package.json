{
  "name": "nexo-assist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:reset": "npm run db:push && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "agent:smoke": "tsx --env-file=.env scripts/smoke-agent.ts",
    "eval:classifier": "tsx --env-file=.env scripts/eval-classifier.ts",
    "turn:smoke": "tsx --env-file=.env scripts/smoke-turn.ts",
    "api:smoke": "tsx scripts/smoke-api.ts",
    "console:smoke": "tsx scripts/smoke-console.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "@ai-sdk/openai": "^4.0.104",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "^1.80.0",
    "@mastra/libsql": "^1.27.1",
    "@mastra/memory": "^1.39.1",
    "ai": "^7.0.155",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}